# Required in production. Set to your deployment URL (no trailing slash).
# In development, leave unset to use loopback OAuth.
# PUBLIC_URL=https://folio.example.com

# Required in production. Generate with: pnpm gen-key
# PRIVATE_KEY={"kty":"EC",...}

# Optional. Path to the SQLite database file.
# DATABASE_PATH=app.db

# Resend API key for email digest (required for digest feature).
# Sign up at resend.com and verify your sending domain.
# RESEND_API_KEY=re_...

# The From address for digest emails.
# EMAIL_FROM=folio <digest@yourdomain.com>

# Secret header value Railway's cron service sends to authenticate cron requests.
# Generate with: openssl rand -hex 32
# CRON_SECRET=...
